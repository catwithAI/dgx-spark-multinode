# MiaAI-Lab GLM-5.3-Flash-EXL3-2x-DGX-Sparks 的 .env，已按 .8 / .12 两台实机填好。
# 用法：由 deploy/overlay.sh 装成 upstream/.env，然后在 head(.8) 上 ./start.sh。
# 原则同 exl3-2x-entrpi：只覆盖必须改的项（网络、权重、端口、显存），
# serving 旋钮一律留空跟随 kit 验证过的默认值。上游默认值见 upstream/.env.example。

# --- 两台机器 ---------------------------------------------------------------
# kit 用 HEAD_IP/WORKER_IP 直接当 rail 地址（NCCL 不走这两个，只用于 ssh 和 rendezvous），
# 沿用本仓库既有的 10.0.0.2 / 10.0.0.3，不是 kit 示例的 10.0.0.1/10.0.0.2。
HEAD_IP=10.0.0.2
WORKER_IP=10.0.0.3
WORKER_USER=ai
WORKER_HOME=/home/ai

# 200GbE 直连光缆。本地两台插的都是第二个口 f1，不是 kit 默认的 head f1 / worker f0。
HEAD_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IF=enp1s0f1np1
WORKER_CX7_IB=rocep1s0f1
NCCL_IB_GID_INDEX=3

# --- 权重 -------------------------------------------------------------------
# 与 exl3-2x-entrpi 是同一份 EXL3 4bpw 权重（brandonmusic snapshot 5ab363a8 的字节一致镜像），
# 但 kit 走 HF cache 布局而不是 /home/ai/models 下的裸目录，所以两套不能直接共用一份落盘。
# 详见 ../README.md「两套栈的权重不共用」。HF_HOME 指到统一权重盘下，别塞进 ~/.cache。
MODEL=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
MODEL_FALLBACK=brandonmusic/GLM-5.3-Flash-tr3-4bpw
MODEL_REVISION=25a44fdbf16862a46b7cc9921142c6c81350af2f
HF_HOME=/home/ai/models/hf-cache
# 两台各存一份（rsync），不走 NFS：worker 从 head 的 HF cache 挂载会把 164 GiB
# 的加载压到光缆上，而且和 entrpi 那套的 local 模式行为不一致。
NFS_SHARE=0

# --- 镜像 -------------------------------------------------------------------
# 留空跟随 kit 当前发行 tag。国内直连 ghcr.io 只有 0.1 MB/s，
# 先用 scripts/pull-image.sh 走 ghcr.chenby.cn 拉好再 retag，然后 SKIP_PULL=1 ./start.sh。
#IMAGE=ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3-instanttensor

# --- serving -----------------------------------------------------------------
PORT=8888
# 集群约定：客户端统一用 glm-5.3-flash 这个 id（与 entrpi 那套一致），
# 不用 kit 默认的 GLM-5.3-Flash-EXL3，这样两套栈可以互换而不用改客户端。
SERVED_MODEL_NAME=glm-5.3-flash
# GPU_MEM_UTIL 不在这里写：head 0.78 / worker 0.90 两台不同，
# 由 modelhub 按角色经 deploy/overlay.sh 注入（见 ../../../../scripts/lib-overlay.sh）。
#GPU_MEM_UTIL=

# 上下文与 KV。kit 默认 850k + 显式 14 GiB KV 池（instanttensor 加载器下必须显式给，
# 否则 profile 出来的池装不下一个满长请求，引擎拒绝启动，见上游 #204）。
# 我们这两台 head 还要养 blade 全家桶，显存占比被压到 0.78，850k 的池放不下，
# 所以降到 512k 并把 KV 池同步降到 10 GiB（≈ 655k token，1.28x）。
# 要回 850k：先把 head 上的业务容器停掉，GPU_MEM_UTIL 回 0.85，再把下面两行还原成 kit 默认。
MAX_MODEL_LEN=524288
EXTRA_ARGS="--kv-cache-memory-bytes 10737418240"

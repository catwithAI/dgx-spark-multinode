# 参考：ai@192.168.130.8:/home/ai/ds4-dspark-2x-vision-src/fleet.env 原样（取自 2026-09-13，kit 入库 ds4-vision-kit-20260911）。
# 只用于看键名/含义；盒子上的实际值由 deploy/overlay.sh 从 modelhub fleet.env 按角色渲染进 upstream/fleet.env。
# fleet.env — this fleet's wiring. Sourced by every script in this directory.
#
# Differences from the upstream repo's asusi/bluey fleet, and why:
#   * fabric is 10.0.0.0/24 on enp1s0f1np1 (rocep1s0f1), NOT 192.168.192.0/24 on
#     enp1s0f0np0. On these boxes rocep1s0f0 is DOWN (40G QDR, no link);
#     rocep1s0f1 is the ACTIVE 200G HDR link and carries 10.0.0.2/10.0.0.3.
#   * weights are LOCAL on both nodes at /home/ai/models, so no NFS split:
#     upstream has rank0 read the worker's export over NFS. Here both ranks
#     bind-mount the same local path. Nothing to mount, one less failure mode.
#   * plane B (roceP2p1s0f1) is ACTIVE 200G but carries no IP, so it is not a
#     usable second plane -> NCCL_IB_MERGE_NICS stays 0, same as upstream.

HEAD_IP=10.0.0.2                     # spark-e9d7, rank 0, serves :8888
WORKER_IP=10.0.0.3                   # spark-c915, rank 1
WORKER_SSH=ai@10.0.0.3

NCCL_IB_HCA=rocep1s0f1
FABRIC_IFNAME=enp1s0f1np1

MASTER_PORT=25440
PORT=8888

IMAGE=vllm-dspark-runtime:dspark-nvfp4-stage-c
NAME=vllm_ds4_vision

# The OpenAI-API model id clients send. Upstream's launcher serves the vision
# checkpoint under the TEXT recipe's id (deepseek-v4-flash-dspark), which is
# misleading once both lanes exist on one fleet. This is the id the repo's own
# sparkrun recipe uses for this checkpoint.
SERVED_MODEL_NAME=deepseek-v4-flash-vision-exp

MODELS_HOST=/home/ai/models
MODEL_DIR=DeepSeek-V4-Flash-Vision-Exp   # uncensored drop-in: keys-DeepSeekV4Flash-Vision-EXP-ablit

REPO_DIR=/home/ai/ds4-dspark-2x-vision-src

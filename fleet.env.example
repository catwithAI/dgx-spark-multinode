# ============================================================
# DGX Spark 集群统一约定 —— 与 modelhub_cli 的 fleet.env 同一套键名
# 复制到目标机 /home/ai/modelhub/fleet.env（modelhub 读它），
# 本仓库各部署方案的默认值也按这里对齐。
# ============================================================

# --- 模型权重根目录（宿主机）。每个模型一个子目录，目录名 = 容器内 /models/<name> ---
MODELS_DIR=/home/ai/models
# 容器内统一挂载点（只读）
MODELS_MOUNT=/models

# --- 大模型 OpenAI 兼容 API 端口。所有 LLM 方案共用；同一时刻只跑一个模型 ---
API_PORT=8888

# --- 本仓库在目标机上的 checkout；modelhub 的 UPSTREAM_DIR 指向它下面的 upstream/ ---
RECIPES_ROOT=/home/ai/dgx-spark-multinode

# --- 双节点 fabric（200G 直连光缆，不是管理网）。按实际机器对填写 ---
HEAD_IP=10.0.0.2
WORKER_IP=10.0.0.3
WORKER_SSH=ai@10.0.0.3
FABRIC_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1
# NCCL_IB_GID_INDEX 故意不写：每台不同且重启会变，运行时从 GID 表发现。
